# xbps package of fili-im (Conversations), read by distro/build-repo.sh of Filigrane (the Makefile installs the files).
# Qt Quick comes with Quickshell already; qt6-wayland is the platform plugin; qt6-multimedia plays voice messages and
# videos; yt-dlp resolves video pages; opus-tools records voice messages. The connectors only link libc (SQLite is built in).
DESC="Conversations, Filigrane's instant messaging: WhatsApp and Google Messages (Qt Quick, Rust, Go)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-wayland>=0 qt6-multimedia>=0 yt-dlp>=0 opus-tools>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6 libQt6Quick.so.6"
PKG_LICENSE="GPL-3.0-or-later"
# Programs of the package (bootstrap.sh without packages builds and copies each one)
BINS="fili-im fili-im-whatsapp fili-im-gmessages"
# Go programs: name:directory (built with go build, next to the Rust binaries)
GO_BINS="fili-im-whatsapp:connectors/whatsapp fili-im-gmessages:connectors/gmessages"
ALIASES="conversations"
